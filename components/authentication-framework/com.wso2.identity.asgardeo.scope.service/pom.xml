<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.wso2.carbon.identity.framework</groupId>
        <artifactId>authentication-framework</artifactId>
        <version>7.8.644</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.wso2.identity.asgardeo.extensions</groupId>
    <packaging>bundle</packaging>
    <artifactId>com.wso2.identity.asgardeo.scope.service</artifactId>
    <version>1.0.257-SNAPSHOT</version>
    <name>Asgardeo Scope Service</name>

    <properties>
        <grpc.version>1.51.1</grpc.version>
    </properties>

    <dependencies>
        <!--gRPC Dependencies-->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!--Commons Logging for gRPC code-->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version>
            <scope>provided</scope>
        </dependency>
        <!--OSGi service component (for ComponentContext)-->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component</artifactId>
            <version>1.3.0</version>
            <scope>provided</scope>
        </dependency>
        <!--OSGi annotations for service component-->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.3.0</version>
            <scope>provided</scope>
        </dependency>
        <!--GraalVM SDK for polyglot proxy types used in gRPC code-->
        <dependency>
            <groupId>org.wso2.orbit.graalvm.sdk</groupId>
            <artifactId>graal-sdk</artifactId>
            <version>22.3.4.wso2v1</version>
            <scope>provided</scope>
        </dependency>
        <!--
        Framework dependency for compile-time interfaces only.
        Marked as provided + optional to avoid transitive dependency resolution.
        All transitive dependencies excluded - we only need the interfaces for compilation.
        OSGi container will provide these classes at runtime.
        -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.authentication.framework</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Private-Package>
                            com.wso2.identity.asgardeo.scope.service.internal,
                            com.google.common.util.concurrent.*,
                            io.perfmark.*,
                        </Private-Package>
                        <Export-Package>
                            !com.wso2.identity.asgardeo.scope.service.internal,
                            com.wso2.identity.asgardeo.scope.service.*; version = "${project.version}",
                            io.grpc.*; version = "${grpc.version}",
                            com.google.protobuf.*; version = "3.21.12"
                        </Export-Package>
                        <Import-Package>
                            org.apache.commons.logging; version="[1.2,2.0)",
                            org.osgi.framework; version="[1.7.0,2.0.0)",
                            org.osgi.service.component; version="[1.2.0,2.0.0)",
                            org.osgi.service.component.annotations; version="[1.2.0,2.0.0)",
                            org.graalvm.polyglot.proxy; version="[22.3,23.0)",
                            org.wso2.carbon.identity.application.authentication.framework.config.model.graph.graaljs.engine,
                            org.wso2.carbon.identity.application.authentication.framework.config.model.graph.graaljs.engine.proto,
                            org.wso2.carbon.identity.application.authentication.framework.config.model.graph.graaljs.engine.proto.grpc,
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
